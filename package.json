{
  "name": "inspect-comment",
  "version": "2.0.0",
  "description": "Dev-only element inspector + comment queue: hover, click, comment, copy one markdown review block naming each element precisely. Vanilla + React.",
  "keywords": [
    "devtools",
    "inspector",
    "design-review",
    "annotate",
    "feedback",
    "element-picker"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/inspect-comment.js",
  "types": "./src/inspect-comment.d.ts",
  "exports": {
    ".": {
      "types": "./src/inspect-comment.d.ts",
      "default": "./src/inspect-comment.js"
    },
    "./react": "./src/DevInspector.tsx",
    "./iife": "./dist/inspect-comment.js"
  },
  "files": [
    "src/",
    "dist/",
    "auto.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "demo": "node scripts/build.mjs && npx --yes serve . -l 4321"
  }
}

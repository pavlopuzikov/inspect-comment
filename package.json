{
  "name": "inspect-comment",
  "version": "2.1.0",
  "description": "Dev-only element inspector + comment queue: hover, click, comment, copy one markdown review block naming each element precisely. Reads React Server Components, computes WCAG contrast, and records live CSS edits as before/after pairs.",
  "keywords": [
    "devtools",
    "inspector",
    "design-review",
    "annotate",
    "feedback",
    "element-picker",
    "accessibility",
    "wcag",
    "contrast",
    "react",
    "nextjs",
    "ai-agent",
    "mcp",
    "screenshot",
    "focus-order",
    "bookmarklet"
  ],
  "license": "MIT",
  "author": "Pavlo Puzikov (https://github.com/pavlopuzikov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlopuzikov/inspect-comment.git"
  },
  "homepage": "https://github.com/pavlopuzikov/inspect-comment#readme",
  "bugs": "https://github.com/pavlopuzikov/inspect-comment/issues",
  "type": "module",
  "main": "./src/inspect-comment.js",
  "types": "./src/inspect-comment.d.ts",
  "exports": {
    ".": {
      "types": "./src/inspect-comment.d.ts",
      "default": "./src/inspect-comment.js"
    },
    "./react": "./src/DevInspector.tsx",
    "./auto": "./auto.js",
    "./iife": "./dist/inspect-comment.js",
    "./package.json": "./package.json",
    "./mcp": "./mcp/server.mjs"
  },
  "sideEffects": [
    "./auto.js",
    "./dist/inspect-comment.js"
  ],
  "files": [
    "src/",
    "dist/",
    "mcp/",
    "auto.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bookmarklet": "node scripts/bookmarklet.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "mcp": "node mcp/server.mjs",
    "demo": "node scripts/build.mjs && npx --yes serve . -l 4321"
  },
  "bin": {
    "inspect-comment-mcp": "./mcp/server.mjs"
  }
}
